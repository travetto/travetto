{
  "import": [
    "@travetto/lint/resources/cspell.json"
  ],
  "dictionaries": ["lorem-ipsum"],
  "ignorePaths": [
    "archived/**",
    "**/gen/**/*.html",
    "**/DOC.html",
    "**/README.md",
    "**/*.generated.*",
    "**/*.tpl",
    "**/*.svg"
  ],
  "words": [
    "ABCDEFGHJIJKLMNOPQRSTUVWXYZ",
    "addgroup",
    "adduser",
    "asar",
    "embracinglife",
    "contenttype",
    "dbconfig",
    "decompressor",
    "decompressors",
    "estypes",
    "fnames",
    "GraphViz",
    "olivegreen",
    "pgcrypto",
    "PRIMARYKEY", 
    "SAVEPOINT",
    "tinyint",
    "transpilable",
    "transpiling",
    "uncategorized",
    "upserted",
    "upserting",
    "upserts",
    "xcopy",
    "xpack"
  ]
}
