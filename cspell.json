{
  "import": [
    "@travetto/lint/resources/cspell.json"
  ],
  "ignorePaths": [
    "archived/**",
    "**/gen/**/*.html",
    "**/DOC.html",
    "**/README.md",
    "**/*.generated.*",
    "**/*.tpl",
    "**/*.svg"
  ],
  "words": [
    "ABCDEFGHJIJKLMNOPQRSTUVWXYZ",
    "addgroup",
    "adduser",
    "asar",
    "bmbo",
    "embracinglife",
    "contenttype",
    "dbconfig",
    "estypes",
    "fnames",
    "jsxs",
    "letmein",
    "olivegreen",
    "oxlint",
    "optoken",
    "pgcrypto",
    "preid",
    "premajor",
    "preminor",
    "prepatch",
    "reinit",
    "subsubtitle",
    "xcopy",
    "xpack"
  ]
}
