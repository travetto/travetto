{
  "name": "@travetto/doc",
  "version": "8.0.0",
  "private": false,
  "description": "Documentation support for the Travetto framework",
  "keywords": [
    "docs",
    "travetto",
    "typescript"
  ],
  "homepage": "https://travetto.io",
