{
  "name": "@travetto/test",
  "version": "8.0.1",
  "description": "Declarative test framework",
  "keywords": [
    "ast-transformations",
    "decorators",
    "testing",
    "travetto",
    "typescript",
    "unit-testing"
  ],
  "homepage": "https://travetto.io",
  "license": "MIT",
  "author": {
    "name": "Travetto Framework",
    "email": "travetto.framework@gmail.com"
  },
  "repository": {
    "url": "git+https://github.com/travetto/travetto.git",
    "directory": "module/test"
  },
  "files": [
    "__index__.ts",
    "src",
    "support"
  ],
  "type": "module",
  "main": "__index__.ts",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@travetto/registry": "^8.0.1",
    "@travetto/runtime": "^8.0.1",
    "@travetto/terminal": "^8.0.1",
    "@travetto/worker": "^8.0.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@travetto/cli": "^8.0.1",
    "@travetto/transformer": "^8.0.1"
  },
  "peerDependenciesMeta": {
    "@travetto/transformer": {
      "optional": true
    },
    "@travetto/cli": {
      "optional": true
    }
  },
  "travetto": {
    "displayName": "Testing",
    "workspaceInclude": true,
    "roles": [
      "test"
