{
  "version": "0.2",
  "ignorePaths": [
    "*.svg"
  ],
  "useGitignore": true,
  "import": [
    "./cspell-node-modules.js"
  ],
  "dictionaryDefinitions": [],
  "dictionaries": [],
  "words": [
    "Appender",
    "bgcolor",
    "COLORFGBG",
    "COLORTERM",
    "cullable",
    "httponly",
    "maxlength",
    "millis",
    "pageable",
    "premajor",
    "preminor",
    "prepatch",
    "reinit",
    "SIGUSR2",
    "subsubtitle",
    "workpool",
    "xunit"
  ],
  "ignoreRandomStrings": true,
  "ignoreWords": [],
  "ignoreRegExpList": [
    "/(dockerImage|image)\\s*[:=]\\s*.*/",
    "Δ",
    "Ⲑ",
    "jsx",
    "/^(import|export)\\s*.*/",
    "/import[(][^)]+[)]/",
    "/[&]\\w+;/",
    "/\\^[^$]+?[$]/",
    "/\\b([a-z0-9]+(-[a-z0-9]+)*\\.)+[a-z]{2,}\\b/gi"
  ],
  "enabled": true
}
