{
  "version": "0.2",
  "ignorePaths": [
    "*.svg"
  ],
  "useGitignore": true,
  "dictionaryDefinitions": [],
  "dictionaries": ["lorem-ipsum", "npm", "posix-signals", "html"],
  "words": [
    "Activatible",
    "Appender",
    "bgcolor",
    "codegen",
    "COLORFGBG",
    "COLORTERM",
    "cullable",
    "decompressor",
    "decompressors",
    "Fastify",
    "Firestore",
    "GraphViz",
    "httponly",
    "maxlength",
    "MEDIUMINT",
    "millis",
    "pageable",
    "PRIMARYKEY",
    "redefinable",
    "Renderable",
    "SAVEPOINT",
    "SIGUSR2",
    "TINYINT",
    "transactionality",
    "transpilable",
    "transpiling",
    "travetto",
    "trvc",
    "uncategorized",
    "upserted",
    "upserting",
    "upserts",
    "workpool",
    "xunit"
  ],
  "ignoreRandomStrings": true,
  "ignoreWords": [],
  "ignoreRegExpList": [
    "/\"[^\"]+\": \"(([^]|~)?[0-9]+[.][0-9]+)|(file:.*?)\"/",
    "/(dockerImage|image)\\s*[:=]\\s*.*/",
    "/\\^[^$]+?[$]/",
    "Δ",
    "Ⲑ",
    "/^(import|export)\\s*.*/",
    "/import[(][^)]+[)]/",
    "/\\b([a-z0-9]+(-[a-z0-9]+)*\\.)+[a-z]{2,}\\b/gi"
  ],
  "enabled": true
}
