{
  "version": "0.2",
  "ignorePaths": [
    "**/*.d.ts",
    "**/node_modules/**",
    "**/.git/**",
    "**/.trv/**",
    "**/out/**",
    "**/dist/**",
    "*.svg",
    "**/gen/**/*.html",
    "**/DOC.html",
    "**/README.md",
    "**/*.generated.*",
    "**/*.tpl",
    "**/fixtures/**",
    "**/resources/**",
    "**/.vscode/**"
  ],
  "dictionaryDefinitions": [],
  "dictionaries": ["lorem-ipsum", "npm", "posix-signals", "html"],
  "words": [
    "Activatible",
    "addgroup",
    "adduser",
    "Appender",
    "asar",
    "bgcolor",
    "contenttype",
    "cullable",
    "dbconfig",
    "estypes",
    "Fastify",
    "Firestore",
    "fnames",
    "httponly",
    "jsxs",
    "maxlength",
    "millis",
    "oneline",
    "optoken",
    "pageable",
    "pgcrypto",
    "preact",
    "preid",
    "premajor",
    "preminor",
    "prepatch",
    "Reindex",
    "reinit",
    "Renderable",
    "subsubtitle",
    "travetto",
    "trvc",
    "codegen",
    "savepoint",
    "decompressor",
    "decompressors",
    "redefinable",
    "transactionality",
    "transpilable",
    "transpiling",
    "PRIMARYKEY",
    "TINYINT",
    "workpool",
    "uncategorized",
    "upserted",
    "upserts",
    "GraphViz",
    "upserting",
    "xcopy",
    "xpack",
    "xunit",
    "ABCDEFGHJIJKLMNOPQRSTUVWXYZ",
    "bmbo",
    "letmein",
    "olivegreen",
    "Ⲑid"
  ],
  "ignoreRandomStrings": true,
  "ignoreWords": [],
  "ignoreRegExpList": [
    "/\"[^\"]+\": \"(([^]|~)?[0-9]+[.][0-9]+)|(file:.*?)\"/",
    "/(dockerImage|image)\\s*[:=]\\s*.*/",
    "/\\^[^$]+?[$]/",
    "Δ",
    "/^(import|export)\\s*.*/",
    "/import[(][^)]+[)]/",
    "/\\b([a-z0-9]+(-[a-z0-9]+)*\\.)+[a-z]{2,}\\b/gi"
  ],
  "enabled": true
}
